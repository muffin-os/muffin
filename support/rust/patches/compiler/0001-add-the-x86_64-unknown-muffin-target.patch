index 0000000000000000000000000000000000000000..35017107259fff5752438d82f1b7ce32745c55ee
--- /dev/null
+++ b/compiler/rustc_target/src/spec/targets/x86_64_unknown_muffin.rs
@@ -0,0 +1,52 @@
+// muffin userspace on x86_64 with SSE2, the SSE float ABI and unwinding.
+//
+// This file transcribes `X86_64_UNKNOWN_MUFFIN` in `bazel/toolchains/spec.bzl` of
+// muffin-os/muffin key by key. Change both together: the stock-nightly build loads the
+// JSON twin and the stage-2 build loads this file.
+
+use crate::spec::{
+    Arch, Cc, CodeModel, LinkerFlavor, Lld, Os, PanicStrategy, RelocModel, RelroLevel,
+    SanitizerSet, StackProbeType, Target, TargetMetadata, TargetOptions, cvs,
+};
+
+pub(crate) fn target() -> Target {
+    let opts = TargetOptions {
+        os: Os::Muffin,
+        families: cvs!["unix"],
+        cpu: "x86-64".into(),
+        plt_by_default: false,
+        max_atomic_width: Some(64),
+        stack_probes: StackProbeType::Inline,
+        // The muffin ELF loader accepts only `ET_EXEC`.
+        position_independent_executables: false,
+        static_position_independent_executables: false,
+        relocation_model: RelocModel::Static,
+        relro_level: RelroLevel::Full,
+        linker_flavor: LinkerFlavor::Gnu(Cc::No, Lld::Yes),
+        linker: Some("rust-lld".into()),
+        // AVX stays off because the kernel saves FPU state with `fxsave`, which does
+        // not cover YMM.
+        features: "-mmx,+fxsr,+sse,+sse2,-sse3,-ssse3,-sse4.1,-sse4.2,-avx,-avx2".into(),
+        supported_sanitizers: SanitizerSet::KCFI | SanitizerSet::KERNELADDRESS,
+        disable_redzone: true,
+        panic_strategy: PanicStrategy::Unwind,
+        code_model: Some(CodeModel::Kernel),
+        ..Default::default()
+    };
+    Target {
+        llvm_target: "x86_64-unknown-none-elf".into(),
+        metadata: TargetMetadata {
+            description: Some(
+                "muffin userspace, x86_64 with SSE2, the SSE float ABI and unwinding".into(),
+            ),
+            tier: Some(3),
+            host_tools: Some(false),
+            std: Some(true),
+        },
+        pointer_width: 64,
+        data_layout:
+            "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128".into(),
+        arch: Arch::X86_64,
+        options: opts,
+    }
+}
