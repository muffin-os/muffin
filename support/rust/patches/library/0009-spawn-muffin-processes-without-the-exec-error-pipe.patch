 use crate::sys::fs::OpenOptions;
 use crate::sys::pipe::pipe;
 use crate::sys::process::env::{CommandEnv, CommandEnvs, CommandResolvedEnvs};
-use crate::sys::{FromInner, IntoInner, cvt_r};
-use crate::{fmt, io, mem};
+#[cfg(not(target_os = "muffin"))]
+use crate::sys::cvt_r;
+use crate::sys::{FromInner, IntoInner};
+use crate::{fmt, io};
+#[cfg(not(target_os = "muffin"))]
+use crate::mem;
 
 mod cstring_array;
 
@@ -633,6 +637,19 @@ impl<'a> fmt::Debug for CommandArgs<'a> {
 
 pub type ChildPipe = crate::sys::pipe::Pipe;
 
+// shortcut: muffin has no pipe or poll syscall, so `spawn` fails before it
+// creates output pipes; upgrade when the kernel adds pipe and poll.
+#[cfg(target_os = "muffin")]
+pub fn read_output(
+    _out: ChildPipe,
+    _stdout: &mut Vec<u8>,
+    _err: ChildPipe,
+    _stderr: &mut Vec<u8>,
+) -> io::Result<()> {
+    Err(io::Error::UNSUPPORTED_PLATFORM)
+}
+
+#[cfg(not(target_os = "muffin"))]
 pub fn read_output(
     out: ChildPipe,
     stdout: &mut Vec<u8>,
