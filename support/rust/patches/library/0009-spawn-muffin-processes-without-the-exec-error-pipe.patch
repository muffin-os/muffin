 ////////////////////////////////////////////////////////////////////////////////
 
 impl Command {
+    #[cfg(not(target_os = "muffin"))]
     pub fn spawn(
         &mut self,
         default: Stdio,
@@ -164,6 +167,42 @@ impl Command {
         }
     }
 
+    // shortcut: muffin has no pipe syscall, so the child reports an exec failure
+    // as exit code 127 instead of an error from `spawn`; upgrade when the kernel
+    // adds pipe.
+    #[cfg(target_os = "muffin")]
+    pub fn spawn(
+        &mut self,
+        default: Stdio,
+        needs_stdin: bool,
+    ) -> io::Result<(Process, StdioPipes)> {
+        let envp = self.capture_env();
+
+        if self.saw_nul() {
+            return Err(io::const_error!(
+                ErrorKind::InvalidInput,
+                "nul byte found in provided data",
+            ));
+        }
+
+        let (ours, theirs) = self.setup_io(default, needs_stdin)?;
+
+        // The lock and the child's `mem::forget` follow the generic `spawn`.
+        let env_lock = sys::env::env_read_lock();
+        let pid = unsafe { self.do_fork()? };
+
+        if pid == 0 {
+            crate::panic::always_abort();
+            mem::forget(env_lock);
+            let Err(_) = unsafe { self.do_exec(theirs, envp.as_ref()) };
+            unsafe { libc::_exit(127) }
+        }
+
+        drop(env_lock);
+        // Safety: -1 is the "no pidfd" value of every non-Linux target.
+        Ok((unsafe { Process::new(pid, -1) }, ours))
+    }
+
     // WatchOS and TVOS headers mark the `fork`/`exec*` functions with
     // `__WATCHOS_PROHIBITED __TVOS_PROHIBITED`, and indicate that the
     // `posix_spawn*` functions should be used instead. It isn't entirely clear
@@ -301,7 +340,8 @@ impl Command {
         {
             if let Some(_g) = self.get_groups() {
                 //FIXME: Redox kernel does not support setgroups yet
-                #[cfg(not(target_os = "redox"))]
