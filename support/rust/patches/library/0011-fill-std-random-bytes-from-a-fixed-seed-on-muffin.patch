From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tim Denk <tim.denk@zymtrace.com>
Date: Tue, 3 Nov 2026 12:27:45 +0100
Subject: [PATCH] fill std random bytes from a fixed seed on muffin

The muffin kernel has no entropy source yet. A fixed-seed SplitMix64 lets
HashMap::new work, with predictable keys until the kernel adds getrandom.

diff --git a/library/std/src/sys/random/mod.rs b/library/std/src/sys/random/mod.rs
index e5a66dc463c6b9a351d2f5e89c29ab555aa12fd4..d63799069257fe320111a3e6e677a8228dd8d852 100644
--- a/library/std/src/sys/random/mod.rs
+++ b/library/std/src/sys/random/mod.rs
@@ -59,6 +59,10 @@ cfg_select! {
         mod unix_legacy;
         pub use unix_legacy::fill_bytes;
     }
+    target_os = "muffin" => {
+        mod muffin;
+        pub use muffin::fill_bytes;
+    }
     target_os = "redox" => {
         mod redox;
         pub use redox::fill_bytes;
diff --git a/library/std/src/sys/random/muffin.rs b/library/std/src/sys/random/muffin.rs
new file mode 100644
index 0000000000000000000000000000000000000000..09029649ed2f46f4d25312dff882afc92c76e155
--- /dev/null
+++ b/library/std/src/sys/random/muffin.rs
@@ -0,0 +1,31 @@
+//! Random data from a fixed-seed SplitMix64 generator.
+//!
+//! shortcut: fixed seed, no entropy source in the kernel; upgrade when the
+//! kernel exposes /dev/random or getrandom.
+//!
+//! Every process produces the same sequence, so `HashMap` keys are predictable
+//! and give no HashDoS protection.
+
+use crate::sync::atomic::{Atomic, AtomicU64, Ordering};
+
+/// SplitMix64 advances its state by this odd constant for each output.
+const GAMMA: u64 = 0x9E37_79B9_7F4A_7C15;
+
+/// The state starts at the seed, which is 0.
+static STATE: Atomic<u64> = AtomicU64::new(0);
+
+const fn mix(state: u64) -> u64 {
+    let z = (state ^ (state >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+    let z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+    z ^ (z >> 31)
+}
+
+// The published first output of SplitMix64 for seed 0.
+const _: () = assert!(mix(GAMMA) == 0xE220_A839_7B1D_CDAF);
+
+pub fn fill_bytes(bytes: &mut [u8]) {
+    for chunk in bytes.chunks_mut(8) {
+        let state = STATE.fetch_add(GAMMA, Ordering::Relaxed).wrapping_add(GAMMA);
+        chunk.copy_from_slice(&mix(state).to_ne_bytes()[..chunk.len()]);
+    }
+}
