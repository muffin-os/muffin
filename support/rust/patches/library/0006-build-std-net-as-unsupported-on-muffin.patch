From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tim Denk <tim.denk@zymtrace.com>
Date: Tue, 3 Nov 2026 12:22:11 +0100
Subject: [PATCH] build std net as unsupported on muffin

The muffin kernel has no sockets. std::net returns Unsupported and
std::os::unix::net is left out, as on l4re and trusty.

diff --git a/library/std/src/os/fd/mod.rs b/library/std/src/os/fd/mod.rs
index 473d7ae3e2ae6d5d340dea81aef887a5f7fa854d..335578e7e3662fe1e9bfa83cbaed7921b5c5a6d2 100644
--- a/library/std/src/os/fd/mod.rs
+++ b/library/std/src/os/fd/mod.rs
@@ -13,7 +13,7 @@ mod raw;
 mod owned;
 
 // Implementations for `AsRawFd` etc. for network types.
-#[cfg(not(target_os = "trusty"))]
+#[cfg(not(any(target_os = "trusty", target_os = "muffin")))]
 mod net;
 
 // Implementation of stdio file descriptor constants.
diff --git a/library/std/src/os/fd/owned.rs b/library/std/src/os/fd/owned.rs
index 4ed5c43616a29198d7d074e4c64418bed17cd48f..b73df48031e9e626acd0b2440dfe613625f9c818 100644
