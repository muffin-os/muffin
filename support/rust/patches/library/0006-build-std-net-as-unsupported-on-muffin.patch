 pub mod raw;
diff --git a/library/std/src/sys/net/connection/mod.rs b/library/std/src/sys/net/connection/mod.rs
index 84b53fd375c93c2f766e5040592d37b44df5b732..922da9605ae67a66e8fba5d845b7578d7e70c232 100644
--- a/library/std/src/sys/net/connection/mod.rs
+++ b/library/std/src/sys/net/connection/mod.rs
@@ -1,6 +1,6 @@
 cfg_select! {
     any(
-        all(target_family = "unix", not(target_os = "l4re")),
+        all(target_family = "unix", not(any(target_os = "l4re", target_os = "muffin"))),
         target_os = "windows",
