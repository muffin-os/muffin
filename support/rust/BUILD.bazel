load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("//bazel/toolchains:bootstrap.bzl", "bootstrap_sysroot")
load(":stage2.bzl", "rustc_stage2", "rustc_stage2_exec")

package(default_visibility = ["//visibility:public"])

# Layer 1 of the sysroot, see platforms/BUILD.bazel.
bootstrap_sysroot(
    name = "core_sysroot",
    crates = [
        "@rust_src//:core",
        "@rust_src//:compiler_builtins",
        "@rust_src//:alloc",
    ],
    platform = "//platforms:x86_64-unknown-muffin-bootstrap",
)

# Layer 2 of the sysroot. std pulls in the rest of its graph, including both
# panic runtimes, muffinos-rt and the patched libc.
bootstrap_sysroot(
    name = "std_sysroot",
    crates = ["@rust_src//:std"],
    platform = "//platforms:x86_64-unknown-muffin-std-bootstrap",
)

alias(
    name = "rust",
    actual = ":std_sysroot",
)

# The stage-2 rustc and clippy-driver with the built-in x86_64-unknown-muffin
# target of patches/compiler. `bazel build //support/rust:stage2` puts them in
# bazel-bin/support/rust/stage2/{bin/rustc,bin/clippy-driver,lib}.
rustc_stage2_exec(
    name = "stage2",
    build = ":stage2_build",
)

rustc_stage2(
    name = "stage2_build",
    config = "bootstrap.toml.tpl",
    libllvm = "@ci_llvm//:libllvm",
    llvm = "@ci_llvm//:all",
    llvm_config = "@ci_llvm//:llvm_config",
    srcs = "@rustc_src//:srcs",
)

filegroup(
    name = "stage2_rustc",
    srcs = [":stage2_build"],
    output_group = "rustc",
)

filegroup(
    name = "stage2_clippy",
    srcs = [":stage2_build"],
    output_group = "clippy",
)

filegroup(
    name = "stage2_lib",
    srcs = [":stage2_build"],
    output_group = "lib",
)

# Selects the stage-2 toolchains. `--//support/rust:use_stage2_rustc=false`
# falls back to the JSON-target toolchains of the stock nightly, under which
# every crate with a build script fails analysis (rules_rust puts the target
# JSON `File` into the build-script env, cargo_build_script.bzl). The name
# differs from `stage2` because that target is the compiler.
bool_flag(
    name = "use_stage2_rustc",
    build_setting_default = True,
)

config_setting(
    name = "use_stage2",
    flag_values = {":use_stage2_rustc": "True"},
)
