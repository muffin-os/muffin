load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

# Upstream rust-lang/libc sources with the muffin patch series applied. Not ours
# to lint or format.
_TAGS = ["manual", "noclippy", "norustfmt"]

rust_library(
    name = "libc",
    crate_name = "libc",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    # `rustc-dep-of-std` makes the crate `no_core` and routes `core` through
    # `rustc_std_workspace_core`, the same way the std build uses it.
    crate_features = [
        "rustc-dep-of-std",
        "align",
    ],
    # build.rs cannot run under a JSON target (see spec.bzl). These are the
    # lines it emits unconditionally for a non-linux unix target: `freebsd12`
    # is the default FreeBSD ABI level, the rest are its check-cfg lists.
    rustc_flags = [
        "--cfg=freebsd12",
        # Cargo registers `test`, every `[features]` entry and every optional
        # dependency.
        "--check-cfg=cfg(test)",
        "--check-cfg=cfg(feature,values(\"align\",\"const-extern-fn\",\"default\",\"extra_traits\",\"rustc-dep-of-std\",\"rustc-std-workspace-core\",\"std\",\"use_std\"))",
        "--check-cfg=cfg(emscripten_old_stat_abi)",
        "--check-cfg=cfg(espidf_picolibc)",
        "--check-cfg=cfg(espidf_time32)",
        "--check-cfg=cfg(freebsd10)",
        "--check-cfg=cfg(freebsd11)",
        "--check-cfg=cfg(freebsd12)",
        "--check-cfg=cfg(freebsd13)",
        "--check-cfg=cfg(freebsd14)",
        "--check-cfg=cfg(freebsd15)",
        "--check-cfg=cfg(gnu_file_offset_bits64)",
        "--check-cfg=cfg(gnu_time_bits64)",
        "--check-cfg=cfg(libc_deny_warnings)",
        "--check-cfg=cfg(linux_time_bits64)",
        "--check-cfg=cfg(musl_v1_2_3)",
        "--check-cfg=cfg(musl32_time64)",
        "--check-cfg=cfg(musl_redir_time64)",
        "--check-cfg=cfg(vxworks_lt_25_09)",
        "--check-cfg=cfg(target_os,values(\"switch\",\"aix\",\"ohos\",\"hurd\",\"rtems\",\"visionos\",\"nuttx\",\"cygwin\",\"qurt\",\"muffin\"))",
        "--check-cfg=cfg(target_env,values(\"illumos\",\"wasi\",\"aix\",\"ohos\",\"nto71_iosock\",\"nto80\"))",
        "--check-cfg=cfg(target_arch,values(\"loongarch64\",\"mips32r6\",\"mips64r6\",\"csky\"))",
    ],
    deps = ["@rust_src//:rustc_std_workspace_core"],
    tags = _TAGS,
)
