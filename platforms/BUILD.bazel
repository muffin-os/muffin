package(default_visibility = ["//visibility:public"])

platform(
    name = "x86_64-none",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:none",
    ],
)

# Userspace needs SSE for the C ABI, and the kernel must stay soft-float. An explicit
# constraint keeps the two rust toolchains mutually exclusive, which constraint
# subsetting alone would not.
constraint_setting(name = "float_abi", default_constraint_value = ":softfloat")

constraint_value(name = "softfloat", constraint_setting = ":float_abi")

constraint_value(name = "hardfloat", constraint_setting = ":float_abi")

# The sysroot is built in layers, each under its own platform so a toolchain never
# depends on rlibs whose compilation depends on that same toolchain:
# 1. `:bootstrap`: empty rust_std -> core, compiler_builtins, alloc.
# 2. `:core_only`: rust_std = layer 1 -> libc, muffinos_rt, unwind, panic_*, std.
# 3. `:prebuilt` (default): rust_std = layers 1 and 2 -> user binaries.
constraint_setting(name = "std_source", default_constraint_value = ":prebuilt")

constraint_value(name = "prebuilt", constraint_setting = ":std_source")

constraint_value(name = "bootstrap", constraint_setting = ":std_source")

constraint_value(name = "core_only", constraint_setting = ":std_source")

# `os:none` here does not agree with the spec's `"os": "muffin"`, and must not be
# changed to match it. Every `@crates` target gates `target_compatible_with` on
# `@rules_rust//rust/platform:x86_64-unknown-none`, which resolves through
# `@platforms//os:none`. crate_universe cannot be handed a JSON triple to generate
# a `muffin` condition from, so moving this constraint makes all of userspace
# resolve to `@platforms//:incompatible`.
platform(
    name = "x86_64-unknown-muffin",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:none",
        ":hardfloat",
    ],
)

platform(
    name = "x86_64-unknown-muffin-bootstrap",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:none",
        ":hardfloat",
        ":bootstrap",
    ],
)

platform(
    name = "x86_64-unknown-muffin-std-bootstrap",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:none",
        ":hardfloat",
        ":core_only",
    ],
)
