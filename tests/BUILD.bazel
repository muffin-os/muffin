# `services` is `/bin/init` here because it never exits. `off` powers the
# machine off after a delay, which is what ends the run.
ext2_image(
    name = "services_disk",
    contents = {
        "etc/services/always.yaml": "exec: /bin/true\nrestart: always\nafter: [once]\n",
        "etc/services/crasher.yaml": "exec: /bin/false\nrestart: on-failure\n",
        "etc/services/off.yaml": "exec: /bin/sleepy-poweroff\n",
        "etc/services/once.yaml": "exec: /bin/true\nrestart: on-failure\n",
    },
    files = {
        "bin/init": "//userspace/services",
        "bin/false": "//userspace/utilities/false",
        "bin/sleepy-poweroff": "//tests/bins:sleepy_poweroff",
        "bin/true": "//userspace/utilities/true",
    },
    image_size = "128M",
)

# no-sandbox keeps /dev/kvm and the host qemu-system-x86_64 reachable. The
# harness already degrades to TCG through accel=kvm:tcg when KVM is absent.
#
# Each case boots a QEMU guest with 4G and 4 vcpus. Bazel reserves only one CPU
# and 300M for a large test, so on a 24-core host it starts 24 guests at once,
# and the slowest one misses the harness deadline. The resources tags make Bazel
# reserve the real footprint, which limits the host to six guests at once. The
# timeout must stay above the harness's own 180s deadline plus its 2s grace,
# otherwise Bazel kills the run before the harness can dump its transcript.
[
    rust_test(
        name = name,
        srcs = [name + ".rs"],
        data = [
            ":test_iso",
            ":" + name + "_disk",
            "@ovmf//:x64_code",
            "@ovmf//:x64_vars",
            "@e2fsprogs//:debugfs",
            "@e2fsprogs//:e2fsck",
        ],
        edition = "2024",
        rustc_env = {
            "MUFFIN_TEST_ISO": "$(rootpath :test_iso)",
            "MUFFIN_TEST_DISK": "$(rootpath :{}_disk)".format(name),
            "OVMF_X86_64_CODE": "$(rootpath @ovmf//:x64_code)",
            "OVMF_X86_64_VARS": "$(rootpath @ovmf//:x64_vars)",
            "MUFFIN_DEBUGFS": "$(rootpath @e2fsprogs//:debugfs)",
            "MUFFIN_E2FSCK": "$(rootpath @e2fsprogs//:e2fsck)",
        },
        size = "large",
        tags = [
            "no-sandbox",
            "resources:cpu:4",
            "resources:memory:4096",
        ],
        timeout = "moderate",
        deps = ["//tests/support"],
    )
    for name in [
        "backtrace",
        "compositor",
        "cow_clone",
        "event_waits",
        "exec_identity",
        "exit_codes",
        "execve",
        "execve_reap",
        "fb_ioctl",
        "fb_mmap",
        "file_read",
        "file_write",
        "floats",
        "fork",
        "gpu_nodes",
        "heap_bounds",
        "input_nodes",
        "kstack_overflow",
        "libinput",
        "map_range_rollback",
        "mmap",
        "orphan",
        "posix",
        "sendfd",
        "services",
        "shell",
        "shm",
        "shutdown",
        "shutdown_ignore",
        "shutdown_sigterm",
        "shutdown_sigterm_sleep",
        "signals",
        "signals_edge",
        "sleep",
        "std_smoke",
        "std_unix_socket",
        "threads",
        "true_false",
        "unix_socket",
        "unmap_race",
        "unwind",
        "vfs_mkdir",
    ]
]
