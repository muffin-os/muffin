# A well-formed ELF64 EXEC header with no program headers and e_entry = 1 << 48,
# which is not a canonical x86-64 address. Only the header is needed: every
# other load check passes, so execve reaches the entry address itself.
genrule(
    name = "noncanonical_entry_elf",
    outs = ["noncanonical-entry.elf"],
    cmd = "printf '" +
          "\\177ELF\\002\\001\\001\\000\\000\\000\\000\\000\\000\\000\\000\\000" +
          "\\002\\000\\076\\000\\001\\000\\000\\000" +
          "\\000\\000\\000\\000\\000\\000\\001\\000" +
          "\\100\\000\\000\\000\\000\\000\\000\\000" +
          "\\000\\000\\000\\000\\000\\000\\000\\000" +
          "\\000\\000\\000\\000\\100\\000\\070\\000\\000\\000\\100\\000\\000\\000\\000\\000" +
          "' > $@",
)

# `exec-target` stays outside `/bin/tests` because the execve test execs it.
ext2_image(
    name = "execve_disk",
    contents = {
        "data/hello.txt": _HELLO,
        "data/notelf.txt": "definitely not an ELF\n",
    },
    files = {
        "bin/init": "//tests/bins:test_init",
        "data/noncanonical-entry.elf": ":noncanonical_entry_elf",
        "bin/exec-target": "//tests/bins:exec_target",
        "bin/tests/execve": "//tests/bins:execve",
    },
)

# The sibling task is attached by the kernel to the init process, so the
# execve test itself is `/bin/init` here and `test-init` does not run.
ext2_image(
    name = "execve_reap_disk",
    contents = {
        "data/hello.txt": _HELLO,
        "data/notelf.txt": "definitely not an ELF\n",
        "exec-sibling": "1\n",
    },
    files = {
        "data/noncanonical-entry.elf": ":noncanonical_entry_elf",
        "bin/exec-target": "//tests/bins:exec_target",
        "bin/init": "//tests/bins:execve",
    },
)

