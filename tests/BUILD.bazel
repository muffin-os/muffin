load("@rules_rust//rust:defs.bzl", "rust_test")
load("//bazel/rules:image.bzl", "ext2_image", "limine_iso")

limine_iso(
    name = "test_iso",
    kernel = "//tests/kernel:test-kernel",
)

_HELLO = "muffin says hi\n"

# The kernel cmdline in limine.conf names `/bin/init`, so every disk puts
# `test-init` there. `test-init` forks and execs every file in `/bin/tests` in
# byte-wise sorted name order. The assertions index that order, so a disk that
# runs several entries names them `0-`, `1-`, and so on.
ext2_image(
    name = "mmap_disk",
    files = {
        "bin/init": "//tests/bins:test_init",
        "bin/tests/0-mmap": "//tests/bins:mmap",
        "bin/tests/1-mmap": "//tests/bins:mmap",
    },
)

ext2_image(
    name = "signals_disk",
    files = {
        "bin/init": "//tests/bins:test_init",
        "bin/tests/0-signals-init": "//tests/bins:signals_init",
        "bin/tests/1-signals-init": "//tests/bins:signals_init",
    },
)

ext2_image(
    name = "signals_edge_disk",
    files = {
        "bin/init": "//tests/bins:test_init",
        "bin/tests/0-signals-edge": "//tests/bins:signals_edge",
        "bin/tests/1-signals-edge": "//tests/bins:signals_edge",
        "bin/tests/2-signals-edge": "//tests/bins:signals_edge",
        "bin/tests/3-signals-edge": "//tests/bins:signals_edge",
        "bin/tests/4-signals-edge": "//tests/bins:signals_edge",
        "bin/tests/5-signals-edge": "//tests/bins:signals_edge",
    },
    # Six copies of a debug build do not fit into the 64M default.
    image_size = "128M",
)

ext2_image(
    name = "sleep_disk",
    files = {
        "bin/init": "//tests/bins:test_init",
        "bin/tests/0-sleep": "//tests/bins:sleep",
        "bin/tests/1-sleep": "//tests/bins:sleep",
    },
)

ext2_image(
    name = "exit_codes_disk",
