# no-sandbox keeps /dev/kvm and the host qemu-system-x86_64 reachable. The
# harness already degrades to TCG through accel=kvm:tcg when KVM is absent.
#
# Each case boots a QEMU guest with 4G and 4 vcpus, hence size large: it tells
# Bazel to reserve real resources rather than run six emulators at once. The
# timeout must stay above the harness's own 180s deadline plus its 2s grace,
# otherwise Bazel kills the run before the harness can dump its transcript.
[
    rust_test(
        name = name,
        srcs = [name + ".rs"],
        data = [
            ":test_iso",
            ":" + name + "_disk",
            "@ovmf//:x64_code",
            "@ovmf//:x64_vars",
            "@e2fsprogs//:debugfs",
            "@e2fsprogs//:e2fsck",
        ],
        edition = "2024",
        rustc_env = {
            "MUFFIN_TEST_ISO": "$(rootpath :test_iso)",
            "MUFFIN_TEST_DISK": "$(rootpath :{}_disk)".format(name),
            "OVMF_X86_64_CODE": "$(rootpath @ovmf//:x64_code)",
            "OVMF_X86_64_VARS": "$(rootpath @ovmf//:x64_vars)",
            "MUFFIN_DEBUGFS": "$(rootpath @e2fsprogs//:debugfs)",
            "MUFFIN_E2FSCK": "$(rootpath @e2fsprogs//:e2fsck)",
        },
        size = "large",
        tags = ["no-sandbox"],
        timeout = "moderate",
        deps = ["//tests/support"],
    )
    for name in [
        "cow_clone",
        "exit_codes",
        "execve",
        "execve_reap",
        "fb_ioctl",
        "fb_mmap",
        "file_read",
        "file_write",
        "floats",
        "fork",
        "heap_bounds",
        "kstack_overflow",
        "map_range_rollback",
        "mmap",
        "posix",
        "shutdown",
        "shutdown_ignore",
        "shutdown_sigterm",
        "shutdown_sigterm_sleep",
        "signals",
        "signals_edge",
        "sleep",
        "true_false",
        "unwind",
        "vfs_mkdir",
    ]
]
