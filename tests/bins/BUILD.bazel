load("@rules_rust//rust:defs.bzl", "rust_binary")

package(default_visibility = ["//visibility:public"])

[
    rust_binary(
        name = name,
        srcs = glob(["{}/src/**/*.rs".format(directory)]),
        edition = "2024",
        platform = "//platforms:x86_64-unknown-muffin",
        deps = ["//userspace/minilib"],
    )
    for name, directory in {
        "exec_identity": "exec-identity",
        "exec_target": "exec-target",
        "execve": "execve",
        "fb_ioctl": "fb-ioctl",
        "fb_mmap": "fb-mmap",
        "file_read": "file-read",
        "file_write": "file-write",
        "floats": "floats",
        "fork": "fork",
        "mmap": "mmap",
        "orphan": "orphan",
        "posix": "posix",
        "signals_edge": "signals-edge",
        "signals_init": "signals-init",
        "sleep": "sleep",
        "term_ignorer": "term-ignorer",
        "term_sleeper": "term-sleeper",
        "term_witness": "term-witness",
        "unix_socket": "unix-socket",
        "unwind": "unwind",
    }.items()
]

# std binaries: no minilib, std comes from the sysroot.
[
    rust_binary(
        name = name,
        srcs = ["{}/src/main.rs".format(directory)],
        edition = "2024",
        platform = "//platforms:x86_64-unknown-muffin",
    )
    for name, directory in {
        "exit_code": "exit-code",
        "std_panic_exit": "std-panic-exit",
        "std_smoke": "std-smoke",
        "std_unix_socket": "std-unix-socket",
    }.items()
]

rust_binary(
    name = "test_init",
    srcs = ["test-init/src/main.rs"],
    edition = "2024",
    platform = "//platforms:x86_64-unknown-muffin",
    deps = ["//userspace/libs/sys"],
)

rust_binary(
    name = "sleepy_poweroff",
    srcs = ["sleepy-poweroff/src/main.rs"],
    edition = "2024",
    platform = "//platforms:x86_64-unknown-muffin",
    deps = ["//userspace/libs/sys"],
)
