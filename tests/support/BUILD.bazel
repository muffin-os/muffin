load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "support",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "test_support",
    edition = "2024",
)

rust_test(
    name = "test",
    crate = ":support",
    size = "small",
)
