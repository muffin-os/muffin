load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "support",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "test_support",
    edition = "2024",
)

rust_test(
    name = "test",
    crate = ":support",
    data = [
        "@e2fsprogs//:debugfs",
        "@e2fsprogs//:e2fsck",
        "@e2fsprogs//:mke2fs",
        "@e2fsprogs//:mke2fs_conf",
    ],
    rustc_env = {
        "MUFFIN_DEBUGFS": "$(rootpath @e2fsprogs//:debugfs)",
        "MUFFIN_E2FSCK": "$(rootpath @e2fsprogs//:e2fsck)",
        "MUFFIN_MKE2FS": "$(rootpath @e2fsprogs//:mke2fs)",
        "MUFFIN_MKE2FS_CONF": "$(rootpath @e2fsprogs//:mke2fs_conf)",
    },
    size = "small",
)
