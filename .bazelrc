# The pinned toolchain is nightly-only. Without this no Rust toolchain resolves.
common --@rules_rust//rust/toolchain/channel=nightly

build --@rules_rust//rust/settings:rustfmt.toml=//:rustfmt.toml

# QEMU integration tests need the host qemu-system-x86_64 and /dev/kvm.
test --test_output=errors
test --test_env=PATH

# Without an explicit choice, rules_cc bakes whichever linker it detects into the
# host toolchain's unconditional link_flags, falling back to gold, which rustc
# warns is deprecated and buggy with Rust. bfd ships with binutils, so it is
# present wherever the host C toolchain works. macOS links with ld64 and rejects
# the flag, hence the linux scoping.
#
# Both lines are load-bearing. --linkopt covers the target configuration and
# --host_linkopt the exec configuration, where rules_rust builds its own tooling.
# Dropping either brings the warning back for half the graph.
common --enable_platform_specific_config
build:linux --linkopt=-fuse-ld=bfd
build:linux --host_linkopt=-fuse-ld=bfd

# With no clippy flag at all, rules_rust injects `-Dwarnings` itself, so every
# clippy action fails on any warning. Naming any flag displaces that default,
# which is what keeps a plain `bazel build` reporting instead of failing.
# The tradeoff is rules_rust's own reason for the default: a clippy action that
# exits 0 is cached as success, so its warnings are not reprinted until the
# crate changes.
build --@rules_rust//rust/settings:clippy_flag=-Wclippy::all

# The aspect runs on every build, so coverage follows the target pattern and
# needs no list of labels anywhere. `+` keeps the default outputs as well,
# otherwise a build would produce clippy markers and nothing else.
build --aspects=@rules_rust//rust:defs.bzl%rust_clippy_aspect
build --output_groups=+clippy_checks

# `clippy::all` covers only the clippy namespace, so plain rustc lints such as
# unused_imports would pass as warnings. The `warnings` group closes that.
#
# These sit on `test` alone. That is what makes `bazel build` report and
# `bazel test` gate, and it is the only scoping Bazel offers, since a target
# cannot know which command asked for it.
test --@rules_rust//rust/settings:clippy_flag=-Dclippy::all
test --@rules_rust//rust/settings:clippy_flag=-Dwarnings

# The aspect is already on, so this config only raises the severity. It exists
# for CI, which needs a gate on a machine that has no qemu to run the tests.
build:clippy --@rules_rust//rust/settings:clippy_flag=-Dclippy::all
build:clippy --@rules_rust//rust/settings:clippy_flag=-Dwarnings

build:rustfmt --aspects=@rules_rust//rust:defs.bzl%rustfmt_aspect
build:rustfmt --output_groups=rustfmt_checks

# cargo miri needs the user's rustup install and crates.io.
test:miri --test_env=HOME
test:miri --test_env=RUSTUP_HOME
test:miri --test_env=CARGO_HOME

try-import %workspace%/user.bazelrc
