load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "input",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "libinput",
    edition = "2024",
    deps = [
        "//kernel/abi",
    ] + select({
        # `muffin_sys` builds only for the muffin platform. The host test
        # compiles the crate without the device reader.
        "@platforms//os:none": ["//userspace/libs/sys"],
        "//conditions:default": [],
    }),
)

rust_test(
    name = "test",
    crate = ":input",
    size = "small",
)
