load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "gfx",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    deps = [
        "//kernel/abi",
    ] + select({
        # `muffin_sys` builds only for the muffin platform; the host test
        # compiles the backend without its syscall types.
        "@platforms//os:none": ["//userspace/libs/sys"],
        "//conditions:default": [],
    }),
)

rust_test(
    name = "test",
    crate = ":gfx",
    size = "small",
)

rust_doc_test(
    name = "doc_test",
    crate = ":gfx",
    size = "small",
)
