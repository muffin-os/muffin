load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")
load("//bazel:kernel_crates.bzl", "crate_label")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "gfx",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    deps = [
        "//kernel/abi",
        crate_label("tracing"),
    ],
)

rust_test(
    name = "test",
    crate = ":gfx",
    size = "small",
)

rust_doc_test(
    name = "doc_test",
    crate = ":gfx",
    size = "small",
)
